NODE_ENV=production
PORT=8080

# Required for production API access. Keep the real value in deployment secrets.
GIGFLOW_API_KEY=

# Runtime state path.
GIGFLOW_DATA_PATH=./data/gigflow.json

# Abuse-control defaults may be adjusted per deployment.
GIGFLOW_RATE_LIMIT_WINDOW_MS=60000
GIGFLOW_RATE_LIMIT_MAX=120
